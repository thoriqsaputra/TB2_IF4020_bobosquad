# Smart Contract Configuration
PRIVATE_KEY=your_private_key_here
INFURA_KEY=your_infura_project_id
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployment Settings
DEPLOY_MODE=reuse        # Options: reuse (default), force, auto
FORCE_DEPLOY=false      # Set to true to force new deployment

# Contract Address (auto-filled after deployment)
CONTRACT_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# IPFS Configuration
IPFS_GATEWAY=http://ipfs:8080
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key

# Application Settings
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# 🗄️ Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/tb2_crypto